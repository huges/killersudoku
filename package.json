{
  "name": "killer-sudoku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "lint": "eslint src tests vite.config.ts vitest.config.ts eslint.config.js --config eslint.config.js",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify:catalog": "tsx scripts/verify-catalog.ts",
    "catalog:generate-fixtures": "tsx scripts/generate-catalog-fixtures.ts",
    "catalog:update-reference": "tsx scripts/update-catalog-reference.ts",
    "catalog:register-identities": "tsx scripts/register-catalog-identities.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/node": "22.15.21",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "tsx": "4.19.2"
  }
}
